FROM node:20-slim

WORKDIR /app

RUN apt-get update -y && apt-get install -y openssl curl && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY prisma ./prisma/

RUN npm install

# Generujemy Prisma Client (nie wymaga DB)
RUN npx prisma generate

COPY . .

# Zwiększ pamięć dla Node.js podczas build (zapobiega SIGSEGV)
ENV NODE_OPTIONS="--max-old-space-size=4096"

# Build z timeout i retry
RUN npx next build || (echo "Build failed, retrying..." && sleep 5 && npx next build)

EXPOSE 3000

# Nadajemy uprawnienia do wykonania skryptów (start.sh i coolify-post-deploy.sh są kopiowane przez COPY . .)
RUN chmod +x /app/start.sh /app/coolify-post-deploy.sh

CMD ["/app/start.sh"]
