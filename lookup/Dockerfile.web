# Pin Node 20.15 to avoid kState/transformAlgorithm bug in 20.16+
# https://github.com/vercel/next.js/issues/68319
FROM node:20.15-slim

WORKDIR /app

RUN apt-get update -y && apt-get install -y openssl curl procps && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY prisma ./prisma/

RUN npm install

# Generujemy Prisma Client (nie wymaga DB)
RUN npx prisma generate

COPY . .

# Zwiększ pamięć TYLKO podczas buildu (zapobiega SIGSEGV). W runtime używamy limitu ze start.sh.
# Nie ustawiaj NODE_OPTIONS globalnie – w przeciwnym razie Node w produkcji rezerwuje 4GB heap i zużywa 100% RAM na małym VPS.
RUN NODE_OPTIONS="--max-old-space-size=4096" npx next build || (echo "Build failed, retrying..." && sleep 5 && NODE_OPTIONS="--max-old-space-size=4096" npx next build)

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:3000/api/health || exit 1

RUN chmod +x /app/start.sh /app/coolify-post-deploy.sh

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --ingroup nodejs nextjs && \
    chown -R nextjs:nodejs /app
USER nextjs

CMD ["/app/start.sh"]
