FROM node:20-slim

WORKDIR /app

RUN apt-get update -y && apt-get install -y openssl

COPY package*.json ./
COPY prisma ./prisma/

RUN npm install

# Generujemy Prisma Client (nie wymaga DB)
RUN npx prisma generate

COPY . .

RUN npx next build

EXPOSE 3000

# Uruchamiamy migracje przed startem aplikacji
# 1. Rozwiązujemy zablokowaną migrację (oznaczamy jako applied - obiekty już istnieją w DB)
# 2. Aplikujemy pozostałe oczekujące migracje (w tym OAuth która doda kolumny name i image)
CMD npx prisma migrate resolve --applied 20260111011940_add_premium_until 2>/dev/null || true; \
    npx prisma migrate deploy && npm run start
